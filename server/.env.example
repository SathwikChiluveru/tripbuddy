PORT=3000
HOST=127.0.0.1
MONGO_URI=mongodb://127.0.0.1:27018/tripbuddy_dev
# Production must use the exact public HTTPS frontend origin.
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=12
# Defaults: 50 MiB per account and 5 GiB total local upload storage.
# USER_UPLOAD_QUOTA_BYTES=52428800
# UPLOAD_STORAGE_QUOTA_BYTES=5368709120
# Legacy password auth is disabled by default in production.
# ALLOW_LEGACY_PASSWORD_AUTH=false
# Set only to the exact trusted reverse-proxy hop count (0 disables trust).
TRUST_PROXY_HOPS=0
# Required for Google sign-in; use the same OAuth web client as client/.env.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
